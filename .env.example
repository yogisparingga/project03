# Server Configuration
PORT=3000
SESSION_SECRET=your_session_secret_here_change_this

# AI Provider Selection (openai, gemini, or groq)
AI_PROVIDER=openai

# ============== Google OAuth Configuration ==============
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# ============== OpenAI Configuration ==============
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Set to 'true' to use OpenAI TTS instead of browser's speech synthesis
USE_OPENAI_TTS=true

# ============== Google Gemini Configuration ==============
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ============== Groq Configuration ==============
# Get API key from: https://console.groq.com/keys
# Groq provides fast inference for open-source models (FREE)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=mixtral-8x7b-32768

# ============== Notes ==============
# For FREE options:
# 1. Groq - Very fast, generous free tier
# 2. Gemini - Google's free tier
# 3. OpenAI - Requires payment but offers best quality
#
# For TTS/STT:
# - OpenAI Whisper (STT) - Best quality, requires OpenAI API key
# - OpenAI TTS - Natural voice, requires OpenAI API key
# - Browser TTS/STT - Free fallback option
